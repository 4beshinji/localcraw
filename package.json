{
  "name": "localcraw",
  "version": "0.1.0",
  "description": "Minimal OpenClaw implementation for local LLMs",
  "type": "module",
  "license": "MIT",
  "bin": {
    "localcraw": "./src/cli.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "chat": "tsx src/cli.ts chat",
    "hems:serve": "tsx src/cli.ts hems serve",
    "hems:status": "tsx src/cli.ts hems status",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "commander": "^12.1.0",
    "imapflow": "^1.2.10",
    "json5": "^2.2.3",
    "mqtt": "^5.15.0",
    "openai": "^4.68.0",
    "playwright": "^1.58.2",
    "systeminformation": "^5.31.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
